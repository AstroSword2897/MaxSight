{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsight.dev/schemas/alert-decision.schema.json",
  "title": "AlertDecision",
  "description": "AlertDecision (see docs/architecture/v1/03-stage-a-specification.md, D3.3).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "maxsight.stage_a/2.0"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "hazard_alert",
        "status_announcement"
      ]
    },
    "urgency": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "interrupt": {
      "type": "boolean"
    },
    "message_key": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "expires_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "kind",
    "urgency",
    "interrupt",
    "message_key",
    "params",
    "frame_id",
    "expires_ns"
  ],
  "additionalProperties": false
}
