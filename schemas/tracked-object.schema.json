{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsight.dev/schemas/tracked-object.schema.json",
  "title": "TrackedObject",
  "description": "TrackedObject (see docs/architecture/v1/03-stage-a-specification.md, D3.3).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "maxsight.stage_a/2.0"
    },
    "track_id": {
      "type": "integer",
      "minimum": 0
    },
    "class_name": {
      "type": "string"
    },
    "bbox_xyxy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "xyxy, source pixels"
    },
    "hits": {
      "type": "integer",
      "minimum": 0
    },
    "misses": {
      "type": "integer",
      "minimum": 0
    },
    "age_frames": {
      "type": "integer",
      "minimum": 0
    },
    "track_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "last_det_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "track_id",
    "class_name",
    "bbox_xyxy",
    "hits",
    "misses",
    "age_frames",
    "track_confidence"
  ],
  "additionalProperties": false
}
