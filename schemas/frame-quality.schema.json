{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsight.dev/schemas/frame-quality.schema.json",
  "title": "FrameQualityResult",
  "description": "FrameQualityResult (see docs/architecture/v1/03-stage-a-specification.md, D3.3).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "maxsight.stage_a/2.0"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "enum": [
        "ok",
        "dark",
        "overexposed",
        "blur",
        "obstructed",
        "excess_motion",
        "invalid"
      ]
    },
    "usable": {
      "type": "boolean"
    },
    "luma_mean": {
      "type": "number",
      "minimum": 0,
      "maximum": 255
    },
    "clipped_frac": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "laplacian_var": {
      "type": "number",
      "minimum": 0
    },
    "flow_median_px": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "frame_id",
    "label",
    "usable",
    "luma_mean",
    "clipped_frac",
    "laplacian_var"
  ],
  "additionalProperties": false
}
