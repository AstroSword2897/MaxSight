{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxsight.dev/schemas/rag_reliability.json",
  "title": "RAGReliabilityEvents",
  "description": "Structured observability events for RAG SLO enforcement.",
  "$defs": {
    "RagFailureEvent": {
      "type": "object",
      "required": [
        "failure_type",
        "latency_ms",
        "retrieved_docs",
        "retrieval_score_max"
      ],
      "properties": {
        "failure_type": { "type": "string" },
        "latency_ms": { "type": "number" },
        "retrieved_docs": { "type": "integer" },
        "retrieval_score_max": { "type": "number" }
      }
    },
    "RagAlertEvent": {
      "type": "object",
      "required": ["system", "level", "violations", "severity", "explanation"],
      "properties": {
        "system": { "const": "rag" },
        "level": { "enum": ["info", "warning", "critical"] },
        "violations": { "type": "array", "items": { "type": "string" } },
        "severity": { "enum": ["ok", "high", "critical"] },
        "explanation": { "type": "string" }
      }
    }
  }
}
