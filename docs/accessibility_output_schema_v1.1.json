{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaxSight Accessibility Output Schema v1.1",
  "description": "Complete output schema for MaxSight accessibility intelligence system - Fixed version with semantic clarity, provenance, and safety gating",
  "version": "1.1",
  "type": "object",
  "required": ["frame_id", "timestamp", "detections", "scene_analysis"],
  "properties": {
    "frame_id": {
      "type": "string",
      "description": "Unique identifier for this frame"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp in seconds"
    },
    "user_profile_id": {
      "type": "string",
      "description": "ID of user profile for personalization"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "class_name", "confidence", "box", "distance", "urgency", "priority"],
        "properties": {
          "class": {
            "type": "integer",
            "description": "Class ID"
          },
          "class_name": {
            "type": "string",
            "description": "Human-readable class name"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Overall detection confidence score (aggregated from sources)"
          },
          "confidence_sources": {
            "type": "object",
            "description": "Per-source confidence scores for graceful degradation",
            "properties": {
              "detection": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Detection head confidence"
              },
              "distance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Distance estimation confidence"
              },
              "accessibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Accessibility metrics confidence (findability, recognizability)"
              },
              "urgency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Urgency assessment confidence"
              }
            }
          },
          "box": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4,
            "description": "Bounding box [cx, cy, w, h] normalized"
          },
          "distance": {
            "type": "string",
            "enum": ["near", "medium", "far"],
            "description": "Distance zone"
          },
          "urgency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Urgency level: 0=safe, 1=caution, 2=warning, 3=danger"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Priority score: 90-100=hazard, 70-89=navigation, 40-69=useful, 0-39=non-essential"
          },
          "findability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How easy to find this object (0-1). Optional if accessibility head unavailable."
          },
          "recognizability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How recognizable under low vision (0-1). Optional if accessibility head unavailable."
          },
          "color_discrimination_demand": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How much color distinction is needed (0-1). Optional if accessibility head unavailable."
          }
        }
      }
    },
    "scene_analysis": {
      "type": "object",
      "required": ["scene_type", "lighting_class"],
      "properties": {
        "scene_type": {
          "type": "string",
          "enum": ["kitchen", "bathroom", "classroom", "street", "crosswalk", "hallway", "parking_lot", "office", "bedroom", "living_room", "unknown"],
          "description": "Type of scene/environment"
        },
        "lighting_class": {
          "type": "string",
          "enum": ["bright", "dim", "backlit", "mixed", "fluorescent_flicker"],
          "description": "Lighting condition"
        },
        "scene_contrast_demand": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Contrast demand of the scene (environment-driven). Renamed from contrast_sensitivity for semantic clarity."
        },
        "scene_glare_risk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Glare risk in the scene (environment-driven): 0=none, 1=low, 2=medium, 3=high. Renamed from glare_risk_level for semantic clarity."
        },
        "scene_motion_difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Motion perception difficulty in the scene (environment-driven). Renamed from motion_perception_difficulty for semantic clarity."
        },
        "navigation_difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Navigation difficulty rating (0-1)"
        },
        "hazard_density_heatmap_ref": {
          "type": "string",
          "description": "Reference ID for hazard density heatmap (client requests separately). Replaces embedded base64."
        }
      }
    },
    "functional_vision": {
      "type": "object",
      "properties": {
        "field_of_view_usable": {
          "type": "object",
          "properties": {
            "left": {"type": "number", "minimum": 0, "maximum": 1},
            "right": {"type": "number", "minimum": 0, "maximum": 1},
            "upper": {"type": "number", "minimum": 0, "maximum": 1},
            "lower": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "user_contrast_capacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "User's contrast sensitivity capacity (user-specific). Renamed from contrast_sensitivity for semantic clarity."
        },
        "user_glare_sensitivity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "User's glare sensitivity level (user-specific): 0=none, 1=low, 2=medium, 3=high. Renamed from glare_risk_level for semantic clarity."
        },
        "user_motion_capacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "User's motion perception capacity (user-specific). Renamed from motion_perception_difficulty for semantic clarity."
        }
      }
    },
    "social_context": {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "integer"},
              "box": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 4,
                "maxItems": 4
              },
              "body_orientation": {
                "type": "string",
                "enum": ["facing_user", "facing_away", "sideways"]
              },
              "gesture": {
                "type": "string",
                "enum": ["waving", "pointing", "stop_gesture", "beckoning", "none"]
              },
              "interaction_intent": {
                "type": "string",
                "enum": ["approaching", "looking_at_user", "ignoring"]
              },
              "distance": {
                "type": "string",
                "enum": ["near", "medium", "far"]
              }
            }
          }
        },
        "crowd_flow": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2,
          "description": "Crowd flow direction vector [x, y]"
        }
      }
    },
    "spatial_mapping": {
      "type": "object",
      "properties": {
        "semantic_segmentation_ref": {
          "type": "string",
          "description": "Reference ID for semantic segmentation mask (client requests separately). Replaces embedded base64."
        },
        "room_zones": {
          "type": "object",
          "properties": {
            "walkable": {"type": "number"},
            "obstacles": {"type": "number"},
            "walls": {"type": "number"},
            "furniture": {"type": "number"},
            "entry_exit": {"type": "number"}
          }
        },
        "pathfinding": {
          "type": "object",
          "properties": {
            "recommended_path": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 2,
                "maxItems": 2
              }
            },
            "chokepoints": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 2,
                "maxItems": 2
              }
            },
            "optimal_direction": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "output_recommendations": {
      "type": "object",
      "properties": {
        "output_validity": {
          "type": "object",
          "required": ["confidence", "safe_to_act"],
          "description": "Gating field for all action-oriented outputs. REQUIRED for any output_recommendations.",
          "properties": {
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall confidence in outputs (aggregated from all sources)"
            },
            "safe_to_act": {
              "type": "boolean",
              "description": "Whether it is safe to act on these recommendations. Must be false if confidence < 0.5 or uncertainty > 0.7."
            },
            "uncertainty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall uncertainty score"
            },
            "degraded_modes": {
              "type": "array",
              "items": {"type": "string"},
              "description": "List of heads/modes that are degraded or unavailable (e.g., ['depth', 'accessibility'])"
            }
          }
        },
        "audio": {
          "type": "object",
          "properties": {
            "spatial_beacons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "object_id": {"type": "integer"},
                  "pan": {"type": "number", "minimum": -1, "maximum": 1},
                  "frequency": {"type": "number"},
                  "duration": {"type": "number"}
                }
              }
            },
            "scene_summary": {"type": "string"}
          }
        },
        "haptic": {
          "type": "object",
          "properties": {
            "vibrations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["right_wrist", "left_wrist", "both", "long", "pulsing"]
                  },
                  "intensity": {"type": "number", "minimum": 0, "maximum": 1},
                  "pattern": {
                    "type": "string",
                    "enum": ["single", "double", "pulsing", "ramping"]
                  }
                }
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "properties": {
            "highlight_regions": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 4,
                "maxItems": 4
              }
            },
            "text_overlays": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {"type": "string"},
                  "position": {
                    "type": "array",
                    "items": {"type": "number"},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "size": {
                    "type": "string",
                    "enum": ["small", "medium", "large"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

