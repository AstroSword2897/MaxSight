# CRITICAL ARCHITECTURAL REFACTORING
# This patch shows the key changes needed to enforce safety guarantees

# ============================================================
# CHANGE 1: Lock Stage A backbone to ResNet50+FPN ONLY
# ============================================================

# BEFORE (line 940-958):
#   if self.use_hybrid and self.hybrid_backbone is not None:
#       # Hybrid backbone used in main forward pass - VIOLATES SAFETY
#       ...

# AFTER: Create separate Stage A backbone method
def _forward_stage_a_backbone(self, images: torch.Tensor) -> Tuple[List[torch.Tensor], torch.Tensor]:
    """
    Stage A backbone: ALWAYS ResNet50 + FPN (safety guarantee).
    
    This method is HARD-CODED to use ResNet50+FPN only.
    Hybrid backbone is NEVER used here.
    """
    # ResNet50 forward (ALWAYS)
    x = self.conv1(images)
    x = self.bn1(x)
    x = self.relu(x)
    x = self.maxpool(x)
    
    c2 = self.layer1(x)
    c3 = self.layer2(c2)
    c4 = self.layer3(c3)
    c5 = self.layer4(c4)
    
    # FPN forward (ALWAYS)
    p2, p3, p4, p5 = self.fpn([c2, c3, c4, c5])
    
    # Optional attention (T1+)
    if self.fpn_attention is not None:
        p2 = self.fpn_attention(p2)
        p3 = self.fpn_attention(p3)
        p4 = self.fpn_attention(p4)
        p5 = self.fpn_attention(p5)
    
    # Scene context
    p2_pooled = self.gap(p2).flatten(1)
    p3_pooled = self.gap(p3).flatten(1)
    p4_pooled = self.gap(p4).flatten(1)
    p5_pooled = self.gap(p5).flatten(1)
    scene_feats = torch.cat([p2_pooled, p3_pooled, p4_pooled, p5_pooled], dim=1)
    scene_context = self.scene_proj(scene_feats)
    
    # Fused features for detection
    p3_resized = F.interpolate(p3, size=p4.shape[2:], mode='bilinear', align_corners=False)
    p5_resized = F.interpolate(p5, size=p4.shape[2:], mode='bilinear', align_corners=False)
    fused_features = torch.cat([p3_resized, p4, p5_resized], dim=1)
    fused_features = self.detection_fusion(fused_features)
    
    return [p2, p3, p4, p5], fused_features, scene_context


# ============================================================
# CHANGE 2: Move Temporal to Stage B ONLY
# ============================================================

# BEFORE (line 1055-1100):
#   # Temporal processing BEFORE Stage A - WRONG!
#   if use_temporal and temporal_mode:
#       temporal_outputs = self.temporal_encoder(...)
#       fused_features = fused_features + motion_features  # Modifies Stage A features

# AFTER: Temporal only in Stage B
def _forward_stage_b_backbone(
    self, 
    images: torch.Tensor,
    stage_a_features: torch.Tensor,
    temporal_mode: bool = False,
    B_orig: Optional[int] = None,
    T: Optional[int] = None
) -> Tuple[torch.Tensor, Optional[Dict]]:
    """
    Stage B backbone: Can use Hybrid CNN-ViT and Temporal (tier-dependent).
    
    This runs AFTER Stage A completes.
    """
    # Option 1: Use Hybrid backbone if tier allows (T2+)
    if self.use_hybrid and self.hybrid_backbone is not None:
        # Hybrid backbone for enhanced features
        _, aux_features = self.hybrid_backbone(images, return_all_features=True)
        if aux_features is not None and 'fpn_features' in aux_features:
            # Use hybrid features
            hybrid_fpn = aux_features['fpn_features']
            # Combine with Stage A features
            stage_b_features = self._fuse_stage_features(stage_a_features, hybrid_fpn)
        else:
            stage_b_features = stage_a_features
    else:
        stage_b_features = stage_a_features
    
    # Option 2: Apply temporal processing if tier allows (T5+)
    temporal_outputs = None
    if (self.tier_config.use_temporal_modeling and 
        temporal_mode and B_orig is not None and T is not None and
        self.temporal_encoder is not None):
        
        # Reshape to temporal format
        _, _, H, W = stage_b_features.shape
        stage_b_temporal = stage_b_features.view(B_orig, T, -1, H, W)
        
        # Temporal processing
        temporal_outputs = self.temporal_encoder(stage_b_temporal)
        
        # Get motion features
        motion_features = temporal_outputs.get('motion_features')
        if motion_features is not None:
            motion_features = motion_features.view(B_orig * T, -1, H, W)
            # Project if needed
            if motion_features.shape[1] != stage_b_features.shape[1]:
                if self.temporal_feature_proj is not None:
                    motion_features = self.temporal_feature_proj(motion_features)
            # Add motion to features
            stage_b_features = stage_b_features + motion_features
    
    return stage_b_features, temporal_outputs


# ============================================================
# CHANGE 3: Separate Stage A and Stage B forward methods
# ============================================================

def _forward_stage_a(
    self,
    images: torch.Tensor,
    audio_features: Optional[torch.Tensor] = None
) -> Dict[str, torch.Tensor]:
    """
    Stage A: Fast Safety Pass (<150ms target).
    
    ALWAYS uses ResNet50+FPN backbone.
    NO temporal processing.
    NO hybrid backbone.
    """
    # Backbone (ResNet50+FPN only)
    fpn_features, fused_features, scene_context = self._forward_stage_a_backbone(images)
    
    # Audio fusion (if available, lightweight)
    if audio_features is not None and self.use_audio and self.audio_encoder is not None:
        audio_emb, _ = self.audio_encoder(audio_features)
        combined_context = torch.cat([scene_context, audio_emb], dim=1)
    else:
        audio_emb = torch.zeros(images.size(0), 256, device=images.device)
        combined_context = torch.cat([scene_context, audio_emb], dim=1)
    
    # Apply audio attention if available
    if audio_features is not None and self.spatial_sound is not None:
        audio_attention_map, _, _ = self.spatial_sound(audio_emb)
        if audio_attention_map is not None:
            # Resize and apply
            if audio_attention_map.shape[2:] != fused_features.shape[2:]:
                audio_attention_map = F.interpolate(
                    audio_attention_map,
                    size=fused_features.shape[2:],
                    mode='bilinear',
                    align_corners=False
                )
            fused_features = fused_features * (1.0 + torch.sigmoid(audio_attention_map))
    
    # Condition-specific enhancements
    fused_features = self._apply_condition_enhancements(fused_features)
    
    # Detection heads (safety-critical)
    det_feats = self.detection_head(fused_features)
    cls_logits = self.cls_head(det_feats)
    box_preds = self.box_head(det_feats)
    obj_logits = self.obj_head(det_feats)
    text_logits = self.text_head(det_feats)
    
    # Reshape and process
    H, W = det_feats.shape[2:]
    batch_size = images.size(0)
    
    cls_logits = cls_logits.permute(0, 2, 3, 1).contiguous().reshape(batch_size, H*W, self.num_classes)
    box_preds = box_preds.permute(0, 2, 3, 1).contiguous().reshape(batch_size, H*W, 4)
    obj_logits = obj_logits.permute(0, 2, 3, 1).contiguous().reshape(batch_size, H*W)
    text_logits = text_logits.permute(0, 2, 3, 1).contiguous().reshape(batch_size, H*W)
    
    box_preds = torch.sigmoid(box_preds)
    obj_scores = torch.sigmoid(obj_logits)
    text_scores = torch.sigmoid(text_logits)
    
    # Scene-level predictions
    scene_emb = self.scene_embedding(combined_context)
    urgency = self.urgency_head(combined_context)
    
    # Distance estimation
    expanded_context = combined_context.unsqueeze(1).expand(batch_size, H*W, -1)
    dist_input = torch.cat([expanded_context, box_preds], dim=2)
    distances = self.distance_head(dist_input.view(-1, dist_input.size(-1)))
    distances = distances.view(batch_size, H*W, self.num_distance_zones)
    
    # Depth estimation (NO temporal dependency)
    depth_outputs = self.depth_head_module(fused_features, motion_features=None)
    depth_map = depth_outputs['depth_map']
    depth_uncertainty = depth_outputs['uncertainty']
    
    # Uncertainty check
    uncertainty_score = None
    if self.enable_accessibility_features:
        shared_scene_emb = self.shared_scene_embedding(combined_context)
        uncertainty_score = self.uncertainty_head(shared_scene_emb)
    
    return {
        'classifications': cls_logits,
        'boxes': box_preds,
        'objectness': obj_scores,
        'text_regions': text_scores,
        'scene_embedding': scene_emb,
        'urgency_scores': urgency,
        'distance_zones': distances,
        'depth_map': depth_map,
        'depth_uncertainty': depth_uncertainty,
        'uncertainty': uncertainty_score,
        'fused_features': fused_features,  # For Stage B
        'combined_context': combined_context,  # For Stage B
        'fpn_features': fpn_features,  # For Stage B
    }


def _forward_stage_b(
    self,
    images: torch.Tensor,
    stage_a_outputs: Dict[str, torch.Tensor],
    audio_features: Optional[torch.Tensor] = None,
    temporal_mode: bool = False,
    B_orig: Optional[int] = None,
    T: Optional[int] = None
) -> Dict[str, torch.Tensor]:
    """
    Stage B: Context Pass (opportunistic, tier-dependent).
    
    Can use Hybrid CNN-ViT and Temporal processing.
    """
    stage_b_outputs = {}
    
    # Get Stage A features
    fused_features = stage_a_outputs['fused_features']
    combined_context = stage_a_outputs['combined_context']
    
    # Stage B backbone (Hybrid + Temporal if tier allows)
    stage_b_features, temporal_outputs = self._forward_stage_b_backbone(
        images, fused_features, temporal_mode, B_orig, T
    )
    
    # Tier 2 heads (if tier allows)
    if self.tier_config.tier.value >= 2:
        # Motion head (if temporal available)
        if temporal_outputs is not None:
            motion_features = temporal_outputs.get('motion')
            if motion_features is not None:
                stage_b_outputs['motion'] = motion_features
                stage_b_outputs['temporal_consistency'] = temporal_outputs.get('consistency')
        
        # ROI Priority
        if self.roi_priority_head is not None:
            stage_b_outputs['roi_priority'] = self.roi_priority_head(stage_b_features)
        
        # Contrast head
        if self.contrast_head is not None:
            stage_b_outputs['contrast'] = self.contrast_head(stage_b_features)
    
    # Tier 3 heads (if tier allows)
    if self.tier_config.tier.value >= 3:
        # Scene description
        if self.scene_description_head is not None:
            stage_b_outputs['scene_description'] = self.scene_description_head(
                global_features=combined_context,
                region_features=stage_b_features,
                ocr_features=None  # OCR runs separately
            )
        
        # OCR head
        if self.ocr_head is not None:
            stage_b_outputs['ocr'] = self.ocr_head(stage_b_features)
        
        # Personalization
        if self.personalization_head is not None:
            stage_b_outputs['personalization'] = self.personalization_head(combined_context)
        
        # Predictive alerts
        if self.predictive_alert_head is not None:
            motion_feat = temporal_outputs.get('motion_features') if temporal_outputs else None
            stage_b_outputs['predictive_alerts'] = self.predictive_alert_head(
                scene_features=combined_context,
                motion_features=motion_feat
            )
    
    # Tier 5: Fatigue head
    if self.tier_config.tier.value >= 5 and self.fatigue_head is not None:
        stage_b_outputs['fatigue'] = self.fatigue_head(combined_context)
    
    return stage_b_outputs


# ============================================================
# CHANGE 4: Refactored main forward() method
# ============================================================

def forward(
    self,
    images: torch.Tensor,
    audio_features: Optional[torch.Tensor] = None,
    user_id: Optional[torch.Tensor] = None,
    prev_temporal_state: Optional[Dict] = None,
    use_temporal: bool = False,
    frame_id: Optional[int] = None
) -> Dict[str, torch.Tensor]:
    """
    Forward pass with enforced Stage A/Stage B separation.
    
    Stage A: ALWAYS ResNet50+FPN, <150ms target
    Stage B: Hybrid+Temporal if tier allows, opportunistic
    """
    # Input preprocessing
    temporal_mode = False
    B_orig = None
    T = None
    
    if images.dim() == 5:  # [B, T, 3, H, W]
        temporal_mode = True
        use_temporal = True
        B_orig, T, C_img, H_img, W_img = images.shape
        images = images.view(B_orig * T, C_img, H_img, W_img)
    
    # ============================================================
    # STAGE A: Fast Safety Pass (<150ms)
    # ============================================================
    stage_a_start = time.perf_counter()
    stage_a_outputs = self._forward_stage_a(images, audio_features)
    stage_a_latency = (time.perf_counter() - stage_a_start) * 1000
    
    # Safety check: If Stage A exceeds threshold, skip Stage B
    skip_stage_b = stage_a_latency > 200.0  # 200ms hard limit
    
    # Uncertainty check: If uncertainty too high, skip Stage B
    if stage_a_outputs.get('uncertainty') is not None:
        if (stage_a_outputs['uncertainty'] > 0.7).any():
            skip_stage_b = True
    
    # Combine outputs
    outputs = stage_a_outputs.copy()
    outputs['stage_a_latency_ms'] = stage_a_latency
    
    # ============================================================
    # STAGE B: Context Pass (opportunistic)
    # ============================================================
    if not skip_stage_b:
        stage_b_outputs = self._forward_stage_b(
            images, stage_a_outputs, audio_features,
            temporal_mode, B_orig, T
        )
        outputs.update(stage_b_outputs)
        outputs['stage_b_executed'] = True
    else:
        outputs['stage_b_executed'] = False
        outputs['stage_b_skip_reason'] = 'latency' if stage_a_latency > 200.0 else 'uncertainty'
    
    return outputs

